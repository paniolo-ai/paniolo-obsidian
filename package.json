{
	"name": "paniolo-obsidian",
	"version": "0.1.0",
	"description": "Obsidian plugin — a thin shell over the paniolo CLI (lint, staleness, qmd).",
	"main": "main.js",
	"packageManager": "pnpm@12.8.1",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": ["obsidian", "paniolo"],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/lint": "6.8.5",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^22.10.0",
		"esbuild": "^0.24.2",
		"obsidian": "^1.7.2",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	}
}
